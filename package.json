{
  "name": "outsider-guard",
  "version": "1.3.99",
  "private": true,
  "description": "A mutual layer for agents to collaborate on shared browser pages, interfaces, and goals.",
  "license": "Apache-2.0",
  "author": "Eric",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EZ-VAI/outsider.git"
  },
  "bugs": {
    "url": "https://github.com/EZ-VAI/outsider/issues"
  },
  "homepage": "https://github.com/EZ-VAI/outsider#readme",
  "keywords": [
    "multi-agent",
    "coordination",
    "outcome",
    "resource-leases",
    "recovery",
    "evidence",
    "browser",
    "mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "bin": {
    "outsider": "bin/outsider.mjs",
    "outsider-run": "bin/outsider-run.mjs",
    "outsider-hook": "bin/outsider-hook.mjs",
    "outsider-codex-app-server": "bin/outsider-codex-app-server.mjs"
  },
  "files": [
    "README.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md",
    "release-public-files.json"
  ],
  "scripts": {
    "prepack": "node scripts/refuse-root-pack.mjs",
    "test": "node scripts/test-core.mjs",
    "test:corpus": "node scripts/outsider-gate-corpus.mjs",
    "canary:live": "node scripts/stage05-live-canary.mjs",
    "canary:reliability": "node scripts/stage05-reliability-batch.mjs",
    "canary:recovery": "node scripts/stage05-reliability-batch.mjs --suite recovery",
    "canary:false-green": "node scripts/stage05-reliability-batch.mjs --suite false-green",
    "canary:release-gate": "node scripts/stage05-release-gate-canary.mjs",
    "canary:release-gate:transport": "OUTSIDER_RELEASE_GATE_SUPERVISOR='node scripts/stage05-release-gate-oracle.mjs' node scripts/stage05-release-gate-canary.mjs",
    "canary:release-gate:family": "node scripts/stage05-release-gate-family.mjs",
    "canary:release-gate:family:tally": "node scripts/stage05-release-gate-family-tally.mjs",
    "canary:recovery:family": "node scripts/stage05-recovery-family.mjs",
    "canary:recovery:family:tally": "node scripts/stage05-recovery-family-tally.mjs",
    "canary:r1": "node scripts/stage05-r1-repeatability.mjs",
    "canary:r1:tally": "node scripts/stage05-r1-repeatability-tally.mjs",
    "canary:r4": "node scripts/stage05-r4-recovery.mjs",
    "canary:agent-team:probe": "node scripts/stage05-agent-team-probe.mjs --interactive-pty",
    "canary:endurance": "node scripts/stage05-endurance-canary.mjs",
    "canary:cowork": "node scripts/stage05-cowork-conformance.mjs",
    "canary:codex:probe": "node scripts/stage05-codex-worker-probe.mjs",
    "canary:deepseek": "node scripts/stage05-deepseek-harness-canary.mjs",
    "canary:tally": "node scripts/stage05-reliability-tally.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:stage-public": "node scripts/stage05-public-package.mjs",
    "release:certify": "node scripts/stage05-release-certify.mjs",
    "release:metadata": "node scripts/stage05-public-release-metadata.mjs",
    "plugin:validate": "node scripts/openai-universal-plugin-validate.mjs",
    "risk:shadow": "node scripts/stage05-risk-factor-shadow.mjs",
    "experience:report": "node scripts/stage05-supervised-corpus-report.mjs",
    "experience:serve": "node scripts/stage05-experience-contribution-server.mjs",
    "experience:deploy:cloudflare": "wrangler deploy --config deploy/cloudflare-experience-gateway/wrangler.jsonc",
    "experience:deploy:cloudflare:dry": "wrangler deploy --dry-run --config deploy/cloudflare-experience-gateway/wrangler.jsonc",
    "demo:serve": "wrangler dev --config deploy/cloudflare-product-demo/wrangler.jsonc",
    "demo:deploy": "wrangler deploy --config deploy/cloudflare-product-demo/wrangler.jsonc",
    "demo:deploy:dry": "wrangler deploy --dry-run --config deploy/cloudflare-product-demo/wrangler.jsonc",
    "test:research": "node scripts/test-core.mjs --research",
    "test:coordination": "node --test test/outsider-shared-resource-coordinator.test.js test/outsider-shared-goal-coordinator.test.js test/outsider-shared-agent-layer.test.js",
    "demo:shared-page": "node examples/shared-page.mjs",
    "demo:shared-goals": "node examples/shared-goals.mjs",
    "demo:browser": "node examples/browser-collaboration.mjs",
    "demo:live-agents": "node examples/live-provider-agents.mjs",
    "browser:owner": "node examples/browser-owner.mjs",
    "test:browser": "node --test --test-concurrency=1 test/outsider-browser-coordination.test.js test/outsider-browser-owner.test.js",
    "agent:mcp": "node src/outsider-mcp-server.js",
    "formation:world-state": "node scripts/outsider-world-state-plan.mjs",
    "formation:digital": "node scripts/outsider-first-committed-reality-production.mjs"
  },
  "devDependencies": {
    "wrangler": "4.124.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@sigstore/tuf": "4.0.2",
    "playwright-core": "1.64.1",
    "tuf-js": "4.0.0",
    "zod": "4.6.7"
  }
}
